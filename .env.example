# Copy this file to ".env" and fill it in.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model. "gemini-flash-latest" always points to Google's newest Flash model.
GEMINI_MODEL=gemini-flash-latest

# Optional: Discord webhook URL, so the owner (or you) gets pinged for every new lead
DISCORD_WEBHOOK_URL=

# Password for the lead list page:  /admin?key=THIS_VALUE
ADMIN_KEY=change-me-123

# Which websites may use the widget. "*" = any. For a client: https://theirsite.lt
ALLOWED_ORIGINS=*
